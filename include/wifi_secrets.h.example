// wifi_secrets.h.example — UDP telemetry の接続情報テンプレート (計画書 §3.1)。
//
// 使い方:
//   cp include/wifi_secrets.h.example include/wifi_secrets.h
//   (include/wifi_secrets.h の中身を実際の SSID/パスワード/PC の IP に書き換える)
//
// include/wifi_secrets.h は .gitignore 済み。コミットしないこと。
// このファイルが存在しない場合、telemetry task は no-op になりビルドは通常通り
// 成功する (tasks::telemetryEnabled() が false を返す)。
#pragma once

#define BSL_WIFI_SSID "your-ssid-here"
#define BSL_WIFI_PASS "your-password-here"
#define BSL_TELEMETRY_HOST_IP "192.168.1.100"  // telemetry receiver (PC) の IP
#define BSL_TELEMETRY_UDP_PORT 45678
